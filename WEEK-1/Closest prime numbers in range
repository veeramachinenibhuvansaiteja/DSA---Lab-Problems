class Solution {
    public int[] closestPrimes(int left, int right) {
        boolean[] notPrime = new boolean[right + 1];
        notPrime[0] = true;
    if (right >= 1) notPrime[1] = true;
     for (int i = 2; (long) i * i <= right; i++) {
      if (!notPrime[i]) {
        for (int j = i * i; j <= right; j += i) {
     notPrime[j] = true;
    }
  }
}
    int prev = -1;
    int[] ans = {-1, -1};
     int bestGap = Integer.MAX_VALUE;
    for (int i = left; i <= right; i++) {
    if (!notPrime[i]) {
    if (prev != -1 && i - prev < bestGap) {
    bestGap = i - prev;
    ans[0] = prev;
    ans[1] = i;
   }  
    prev = i;
   }
}
   return ans;
    }
}
