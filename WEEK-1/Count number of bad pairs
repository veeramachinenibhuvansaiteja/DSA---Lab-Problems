class Solution {
    public long countBadPairs(int[] nums) {
        long n = nums.length;
        long total = n * (n - 1) / 2;
        long good = 0;
   HashMap<Integer, Integer> count = new HashMap<>();
    for (int i = 0; i < nums.length; i++) {
    int key = nums[i] - i;
    int seen = count.getOrDefault(key, 0);
     good += seen;
     count.put(key, seen + 1);
   }
     return total - good;
    }
}
